#!/bin/bash
# Reference copy of the native install's /zynthian/config/zynthian_envars_custom.sh
# on this dev machine (Ubuntu 24.04 laptop) - that file itself lives outside
# any git repo (/zynthian/config isn't version controlled, same as on real
# hardware), so this is kept here purely so the tuning work behind it isn't
# only findable on one machine. Not auto-sourced from here - copy/adapt to
# /zynthian/config/zynthian_envars_custom.sh on a given machine as needed.

# Custom envars for running Zynthian on this Ubuntu laptop with the Yamaha AG03
# (desktop test setup, no dedicated GPIO hardware)

export ZYNTHIAN_DIR="/zynthian"
export ZYNTHIAN_CONFIG_DIR="$ZYNTHIAN_DIR/config"
export ZYNTHIAN_SW_DIR="$ZYNTHIAN_DIR/zynthian-sw"
export ZYNTHIAN_UI_DIR="$ZYNTHIAN_DIR/zynthian-ui"
export ZYNTHIAN_SYS_DIR="$ZYNTHIAN_DIR/zynthian-sys"
export ZYNTHIAN_DATA_DIR="$ZYNTHIAN_DIR/zynthian-data"
export ZYNTHIAN_MY_DATA_DIR="$ZYNTHIAN_DIR/zynthian-my-data"
export ZYNTHIAN_RECIPE_DIR="$ZYNTHIAN_SYS_DIR/scripts/recipes"
export ZYNTHIAN_PLUGINS_DIR="$ZYNTHIAN_DIR/zynthian-plugins"
export ZYNTHIAN_PLUGINS_SRC_DIR="$ZYNTHIAN_SW_DIR/plugins"

# So plugins built via zynthian-sys's install_*.sh recipes (which install
# into $ZYNTHIAN_PLUGINS_DIR/lv2) are found, in addition to the normal
# system/user LV2 locations.
export LV2_PATH="/usr/lib/lv2:/usr/local/lib/lv2:$HOME/.lv2:$ZYNTHIAN_PLUGINS_DIR/lv2:$ZYNTHIAN_DATA_DIR/presets/lv2:$ZYNTHIAN_MY_DATA_DIR/presets/lv2"

# No dedicated encoder/GPIO hardware: use touch/mouse UI, dummy encoders in zyncoder
export ZYNTHIAN_WIRING_LAYOUT="TOUCH_ONLY"

# Audio: jackd's own ALSA backend is bound to the laptop's built-in codec
# only (analog out = actual laptop speakers, device 0 - NOT device 3, which
# is HDMI1 and silent unless an HDMI display/speaker is attached). This
# mirrors real Zynthian hardware's pattern (see zynthian-sys's
# zynthian_envars_V5.sh: "-d hw:sndrpihifiberry", the onboard HAT, fixed at
# startup) rather than wiring a specific external interface (Suprema, AG03,
# ...) directly into jackd's own -C/-P flags, which can't survive that
# device disconnecting/reconnecting without restarting jackd itself (see
# openspec/changes/fix-audio-hotplug-support).
#
# External audio interfaces are instead bridged in dynamically at runtime
# by zynautoconnect's existing hotplug machinery (update_hw_audio_ports() /
# start_alsa_in() / start_alsa_out(), via the alsa_in/alsa_out helper
# processes) - the same mechanism real hardware uses for anything beyond
# its onboard HAT. Enabled below via ZYNTHIAN_HOTPLUG_AUDIO. Once bridged
# in, an external device (e.g. the Suprema) shows up as its own selectable
# source/destination in the Audio Input screen / device_cables' cable
# display, not hardcoded here.
export SOUNDCARD_NAME="sofhdadsp"
export JACKD_OPTIONS="-P 70 -t 2000 -d alsa -d hw:sofhdadsp,0 -p 512 -n 3 -r 48000"
export ZYNTHIAN_HOTPLUG_AUDIO="1"

export ZYNTHIAN_UI_ENABLE_CURSOR="1"
export ZYNTHIAN_LOG_LEVEL="20"

# We're not on a Raspberry Pi: give these RPi-only checks harmless values
export RBPI_VERSION="PC (UNSUPPORTED!)"
export RBPI_VERSION_NUMBER="0"

# Adafruit Blinka (board/neopixel_spi): pretend to be a generic Linux PC so
# imports succeed even though there's no real WS281x LED strip attached
export BLINKA_FORCEBOARD="GENERIC_LINUX_PC"
export BLINKA_FORCECHIP="GENERIC_X86"

# Find zynthian-sys helper scripts (e.g. powersave_control.sh)
export PATH="$ZYNTHIAN_SYS_DIR/sbin:$PATH"

# Bluetooth is real system bluetooth here; tell Zynthian it's already
# "on" so it never calls systemctl stop/start bluetooth (which triggers
# a polkit password prompt and isn't something we want it managing)
export ZYNTHIAN_MIDI_BLE_ENABLED="1"

# Never blank/dim the real screen because of Zynthian's idle timer
export ZYNTHIAN_UI_POWER_SAVE_MINUTES="0"

# Without this, the UI auto-sizes to your full monitor resolution and opens
# as a borderless window that's hard to move/close. Use the real V5 touch-
# screen's resolution instead so it behaves like a normal, bounded window.
export DISPLAY_WIDTH="1600"
export DISPLAY_HEIGHT="960"

# Show the "Exit" entry in the Admin menu, so there's a clean, in-app way
# to quit (top-right menu icon -> Admin -> Exit) instead of Ctrl+C.
export ZYNTHIAN_DEBUG_THREAD="1"

# Show the on-screen virtual keypad/knobs overlay (what the official demo
# videos show) since we have no physical encoders/buttons connected.
export ZYNTHIAN_TOUCH_SHOWN="1"

# zynthian-webconf login password (run_zynthian_webconf.sh defaults to
# "zynthian" if unset - change it here instead of leaving the default on
# a machine reachable from the LAN). Its own in-app password-change page
# is disabled for this desktop port (see openspec/changes/
# enable-webconf-access/design.md), so this env var is the only way to
# change it.
#export ZYNTHIAN_WEBCONF_PASSWORD="change-me"
